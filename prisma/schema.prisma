generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Item {
  id            String   @id @default(cuid())
  name          String
  brand         String?
  imageUrl      String?
  colorImageUrl String?
  productUrl    String
  category      String
  color         String?
  season        String   @default("ALL_SEASON")
  createdAt     DateTime @default(now())
  fits          FitItem[]
}

model Fit {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  items     FitItem[]
}

model FitItem {
  fitId  String
  itemId String
  fit    Fit  @relation(fields: [fitId], references: [id], onDelete: Cascade)
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([fitId, itemId])
}
